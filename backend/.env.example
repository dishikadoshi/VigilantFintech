# ═══════════════════════════════════════════════════════════════
#  Vigilant Fintech Backend — Environment Variables
#  Copy to .env — NEVER commit .env to git
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4000
NODE_ENV=production
# Bare origin only — NO /api suffix
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# ── Storage backend ──────────────────────────────────────────
#   sheets  ← production (Google Sheets)
#   mock    ← local dev, no credentials needed
STORAGE_PROVIDER=sheets

# ── Google Sheets (see GOOGLE_SHEETS_SETUP.md) ───────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# ── Email (SMTP) ─────────────────────────────────────────────
# Variable names MUST match exactly — emailService.js reads these
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false            # true for port 465, false for 587
SMTP_USER=vigilantfintech@gmail.com
SMTP_PASS=your-gmail-app-password   # App password, NOT your Gmail login password

# Display name in From header
EMAIL_FROM_NAME=Vigilant Fintech Team
EMAIL_FROM_ADDRESS=vigilantfintech@gmail.com

# Where the "new enquiry" notification emails are sent
ADMIN_EMAIL=vigilantfintech@gmail.com

# ── How to get a Gmail App Password ─────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com → Security → App passwords
# 3. Create a new app password → copy the 16-char code → paste into SMTP_PASS
# 4. Do NOT use your regular Gmail password here — it won't work

# ── Cal.com webhook (see GOOGLE_SHEETS_SETUP.md) ─────────────
# Bookings are made in Cal.com's own popup on the website; Cal.com then
# calls POST /api/webhooks/calcom so the meeting is saved to the "Bookings"
# sheet tab. Any long random string — paste the SAME value into the
# Cal.com webhook's "Secret" field.
CAL_WEBHOOK_SECRET=replace-with-a-long-random-string

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5
