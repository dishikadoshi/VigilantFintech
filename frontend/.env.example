# ═══════════════════════════════════════════════════════════════
#  Frontend — Environment Variables  (copy to .env, never commit it)
#  Only REACT_APP_API_URL is required. Everything else is optional:
#  contact options left empty are simply not shown on the site.
# ═══════════════════════════════════════════════════════════════

# Bare backend origin, NO /api suffix
REACT_APP_API_URL=http://localhost:4000

# Company details (used in nav, footer, titles, legal pages)
REACT_APP_COMPANY_NAME=Vigilant Fintech
REACT_APP_SITE_URL=https://www.your-domain.com

# Contact options — leave blank to hide
REACT_APP_CONTACT_EMAIL=
# Digits only incl. country code, e.g. 15551234567 (powers wa.me links + floating button)
REACT_APP_WHATSAPP_NUMBER=
REACT_APP_LINKEDIN_URL=
REACT_APP_BUSINESS_ADDRESS=

# ── Cal.com booking popup (floating calendar icon) ───────────
# Your booking link WITHOUT the domain: username/event-slug
# e.g. https://cal.com/garvit/45min  →  garvit/45min
# Leave empty and the calendar icon is hidden.
REACT_APP_CAL_LINK=
# Only change if your Cal.com account is on the EU region (https://app.cal.eu)
REACT_APP_CAL_ORIGIN=https://app.cal.com
# dark (default) or light
REACT_APP_CAL_THEME=dark
# Optional accent colour for Cal.com's buttons, e.g. #0b2a4f
REACT_APP_CAL_BRAND_COLOR=

# Optional separate external booking link. If set, the "Book a Free
# Consultation" buttons open it; otherwise they go to the contact form.
REACT_APP_BOOKING_URL=
